{
  "rewrites": [
    { "source": "/api/webflow/:path*", "destination": "/api/webflow?path=:path*" }
  ],
  "functions": {
    "api/generate.js": { "maxDuration": 300, "includeFiles": "config/**" },
    "api/cron.js": { "maxDuration": 300, "includeFiles": "config/**" }
  },
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 13 * * 2,5"
    }
  ]
}
